{
  "$defs": {
    "AssertionSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "response_present",
            "response_regex",
            "tool_forbidden",
            "tool_required",
            "tool_count",
            "argument_equals",
            "argument_in_state",
            "call_order",
            "result_status",
            "precondition_tool",
            "precondition_state",
            "state_equals",
            "state_unchanged"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "AssertionSpec",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "destructive": {
          "default": false,
          "title": "Destructive",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "sensitive_result": {
          "default": false,
          "title": "Sensitive Result",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/AssertionSpec"
      },
      "title": "Assertions",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "title": "Id",
      "type": "string"
    },
    "initial_state": {
      "additionalProperties": true,
      "title": "Initial State",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "schema_version": {
      "const": "anvil.scenario.v1",
      "default": "anvil.scenario.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scripted_actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Scripted Actions",
      "type": "array"
    },
    "suite": {
      "minLength": 1,
      "title": "Suite",
      "type": "string"
    },
    "system_prompt": {
      "minLength": 1,
      "title": "System Prompt",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "array"
    },
    "user_prompt": {
      "minLength": 1,
      "title": "User Prompt",
      "type": "string"
    }
  },
  "required": [
    "id",
    "suite",
    "description",
    "system_prompt",
    "user_prompt"
  ],
  "title": "Scenario",
  "type": "object"
}