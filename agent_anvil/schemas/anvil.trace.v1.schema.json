{
  "$defs": {
    "EventType": {
      "enum": [
        "model_request",
        "model_response",
        "tool_call",
        "tool_result",
        "protocol_error",
        "final_response",
        "state_snapshot"
      ],
      "title": "EventType",
      "type": "string"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "type"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "additionalProperties": true,
      "title": "Agent",
      "type": "object"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "initial_state_digest": {
      "title": "Initial State Digest",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "anvil.trace.v1",
      "default": "anvil.trace.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "suite": {
      "title": "Suite",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "suite",
    "agent",
    "initial_state_digest"
  ],
  "title": "Trace",
  "type": "object"
}